flowchart TD
    A([Start]) --> B["Initialize all 10 slots as Available"]
    B --> C["Display Welcome Banner"]
    C --> D["Display Main Menu"]
    D --> E["Read User Choice"]

    E --> F{Choice?}

    F -->|1| G["VEHICLE ENTRY"]
    F -->|2| H["VEHICLE EXIT"]
    F -->|3| I["PARKING STATUS"]
    F -->|4| J["SEARCH VEHICLE"]
    F -->|5| K["PARKING SUMMARY"]
    F -->|6| L["TRANSACTION HISTORY"]
    F -->|0| M(["Display Goodbye & Exit"])
    F -->|Other| N["Display: Invalid Choice"]

    %% Vehicle Entry Flow
    G --> G1["Read Registration Number"]
    G1 --> G2{Valid Format?}
    G2 -->|No| G2E["Display: Invalid Registration"]
    G2E --> D
    G2 -->|Yes| G3{Duplicate Found?}
    G3 -->|Yes| G3E["Display: Already Parked"]
    G3E --> D
    G3 -->|No| G4{Slot Available?}
    G4 -->|No| G4E["Display: Parking Lot FULL"]
    G4E --> D
    G4 -->|Yes| G5["Allocate First Available Slot"]
    G5 --> G6["Display: Slot Number & Availability"]
    G6 --> D

    %% Vehicle Exit Flow
    H --> H1["Read Registration Number"]
    H1 --> H2{Valid Format?}
    H2 -->|No| H2E["Display: Invalid Registration"]
    H2E --> D
    H2 -->|Yes| H3{Vehicle Found?}
    H3 -->|No| H3E["Display: Vehicle Not Found"]
    H3E --> D
    H3 -->|Yes| H4["Read Parking Duration"]
    H4 --> H5{Duration >= 1?}
    H5 -->|No| H5E["Display: Invalid Duration"]
    H5E --> D
    H5 -->|Yes| H6["Calculate Fee = Duration x Rs.20"]
    H6 --> H7["Print Parking Receipt"]
    H7 --> H8["Record Transaction in History"]
    H8 --> H9["Add Fee to Total Revenue"]
    H9 --> H10["Release Parking Slot"]
    H10 --> D

    %% Parking Status Flow
    I --> I1["Print Slot Table: Number, Registration, Status"]
    I1 --> I2["Display: Total, Occupied, Available, Occupancy %"]
    I2 --> D

    %% Search Vehicle Flow
    J --> J1["Read Registration Number"]
    J1 --> J2{Valid Format?}
    J2 -->|No| J2E["Display: Invalid Registration"]
    J2E --> D
    J2 -->|Yes| J3{Vehicle Found?}
    J3 -->|Yes| J4["Display: Slot Number & Status"]
    J3 -->|No| J5["Display: Vehicle NOT Parked"]
    J4 --> D
    J5 --> D

    %% Parking Summary Flow
    K --> K1["Display: Revenue, Parked, Available, Transactions, Occupancy %"]
    K1 --> D

    %% Transaction History Flow
    L --> L1{Any Transactions?}
    L1 -->|No| L2["Display: No Records Yet"]
    L1 -->|Yes| L3["Print Transaction Table"]
    L3 --> L4["Display: Total Revenue"]
    L2 --> D
    L4 --> D

    %% Invalid choice
    N --> D

    %% Styling
    style A fill:#4CAF50,stroke:#333,color:#fff
    style M fill:#f44336,stroke:#333,color:#fff
    style G fill:#2196F3,stroke:#333,color:#fff
    style H fill:#FF9800,stroke:#333,color:#fff
    style I fill:#9C27B0,stroke:#333,color:#fff
    style J fill:#00BCD4,stroke:#333,color:#fff
    style K fill:#795548,stroke:#333,color:#fff
    style L fill:#607D8B,stroke:#333,color:#fff
